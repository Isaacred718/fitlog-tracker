rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns exactly one document tree at users/{uid}, holding a
    // meta doc (profile/settings/email) plus per-record subcollections
    // (workouts, templates, measurements, customExercises, heartRateData).
    // Only the authenticated owner may read or write any of it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
